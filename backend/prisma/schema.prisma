// Prisma schema for Meetvia
// PostgreSQL database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ThemePreset {
  futuristic_blue @map("futuristic-blue")
  luxury_dark    @map("luxury-dark")
  clean_white    @map("clean-white")
  custom         @map("custom")
}

enum LocationType {
  Public
  Virtual
  Flexible
}

enum FileType {
  image
  video
}

enum CityStatus {
  active
  inactive
}

enum InquiryStatus {
  new_status @map("new")
  reviewed
  contacted
  closed
  rejected
}

enum ApplicationStatus {
  pending
  reviewing
  approved
  rejected
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserRole {
  CUSTOMER
  COMPANION
  ADMIN
}

enum ExperienceStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

enum ExperienceType {
  LOCAL
  CITY
  TRAVEL
}

enum CompanionRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum TripMemberRole {
  OWNER
  MEMBER
}

enum TripTravelType {
  DOMESTIC
  INTERNATIONAL
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

model User {
  id                       String                   @id @default(cuid())
  email                    String?                  @unique
  mobile                   String?                  @unique
  status                   UserStatus               @default(ACTIVE)
  emailVerifiedAt          DateTime?
  mobileVerifiedAt         DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  profile                  UserProfile?
  socialAccounts           SocialAccount[]
  sessions                 Session[]
  otpRequests              OtpRequest[]
  roles                    UserRoleAssignment[]
  experiences              Experience[]
  sentCompanionRequests    CompanionRequest[]       @relation("requester")
  receivedCompanionRequests CompanionRequest[]      @relation("companion")
  availability             CompanionAvailability[]
  bookingsAsCustomer       Booking[]                @relation("bookingCustomer")
  bookingsAsCompanion      Booking[]                @relation("bookingCompanion")
  payments                 Payment[]
  ownedTrips               Trip[]                   @relation("tripOwner")
  tripMemberships          TripMember[]
  waitlists                TripWaitlist[]
  checkIns                 TripCheckIn[]

  @@index([status])
  @@map("users")
}

model UserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  firstName         String?
  lastName          String?
  displayName       String?
  avatarUrl         String?
  bio               String?
  countryCode       String?
  preferredLanguage  String?
  preferredCurrency  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Role {
  id          String               @id @default(cuid())
  name        UserRole             @unique
  description String?
  assignments UserRoleAssignment[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("roles")
}

model UserRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_role_assignments")
}

model SocialAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  lastSeenAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model OtpRequest {
  id         String    @id @default(cuid())
  userId     String?
  mobile     String?
  email      String?
  purpose    String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([mobile, purpose, createdAt])
  @@index([email, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_requests")
}

model SiteSettings {
  id                 String   @id @default(cuid())
  siteName           String
  siteLogo           String?
  favicon            String?
  metaTitle          String
  metaDescription    String?
  contactEmail       String?
  contactPhone       String?
  whatsappNumber     String?
  whatsappMessage    String?
  safetyCheckboxText String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("site_settings")
}

model ThemeSettings {
  id                     String      @id @default(cuid())
  activePreset           ThemePreset @default(futuristic_blue)
  primaryColor           String
  secondaryColor         String
  accentColor            String
  backgroundColor        String
  textColor              String
  fontFamily             String
  borderRadius           Int         @default(12)
  glassmorphismIntensity Int         @default(50)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@map("theme_settings")
}

model HeroSlide {
  id              String   @id @default(cuid())
  heading         String
  subtitle        String?
  backgroundImage String?
  backgroundVideo String?
  overlayOpacity Int      @default(40)
  includesList    String[] @default([])
  ctaText         String?
  ctaLink         String?
  displayOrder    Int      @default(0)
  isVisible       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("hero_slides")
}

model Service {
  id            String       @id @default(cuid())
  title         String
  description   String
  duration      String?
  locationType  LocationType
  image         String?
  video         String?
  thumbnail     String?
  whatsIncluded String[]     @default([])
  buttonText    String       @default("Book Now")
  buttonLink    String?
  isFeatured    Boolean      @default(false)
  isVisible     Boolean      @default(true)
  displayOrder  Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("services")
}

model Media {
  id               String   @id @default(cuid())
  originalFilename String
  storedFilename   String   @unique
  fileType         FileType
  mimeType         String
  fileSize         Int
  storagePath      String
  url              String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("media")
}

model FAQ {
  id           String   @id @default(cuid())
  question     String
  answer       String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("faqs")
}

model Testimonial {
  id           String   @id @default(cuid())
  reviewerName String
  location     String?
  reviewText   String
  rating       Int?
  image        String?
  isVerified   Boolean  @default(false)
  isVisible    Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("testimonials")
}

model City {
  id               String              @id @default(cuid())
  cityName         String
  state            String
  country          String
  status           CityStatus          @default(active)
  displayOrder     Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  experiences      Experience[]
  companionRequests CompanionRequest[]
  bookings         Booking[]

  @@unique([cityName, state])
  @@map("cities")
}

model ContactInquiry {
  id             String        @id @default(cuid())
  fullName       String
  email          String
  mobile         String?
  serviceType    String
  preferredDate  DateTime?
  message        String
  safetyConfirmed Boolean      @default(true)
  status         InquiryStatus @default(new_status)
  adminNotes     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("contact_inquiries")
}

model CompanionApplication {
  id         String            @id @default(cuid())
  fullName   String
  email      String
  mobile     String
  city       String
  experience String
  whyJoin    String
  status     ApplicationStatus @default(pending)
  adminNotes String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@map("companion_applications")
}

model LegalPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("legal_pages")
}

model SocialLink {
  id             String   @id @default(cuid())
  platform       String
  url            String
  iconIdentifier String
  isVisible      Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("social_links")
}

model HowItWorksStep {
  id           String   @id @default(cuid())
  stepNumber   Int
  title        String
  description  String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("how_it_works_steps")
}

model Experience {
  id              String           @id @default(cuid())
  companionId     String
  cityId          String?
  title           String
  slug            String           @unique
  description     String
  type            ExperienceType   @default(LOCAL)
  status          ExperienceStatus @default(DRAFT)
  category        String
  durationMinutes Int
  priceMinor      Int
  currency        String           @default("INR")
  languages       String[]         @default([])
  interests       String[]         @default([])
  inclusions      String[]         @default([])
  exclusions      String[]         @default([])
  meetingPoint    String?
  mediaUrls       String[]         @default([])
  timezone        String           @default("UTC")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  companion       User             @relation(fields: [companionId], references: [id], onDelete: Restrict)
  city            City?            @relation(fields: [cityId], references: [id], onDelete: SetNull)
  bookings        Booking[]

  @@index([companionId, status])
  @@index([cityId, status])
  @@index([category, status])
  @@index([type, status])
  @@map("experiences")
}

model CompanionRequest {
  id          String                  @id @default(cuid())
  requesterId String
  companionId String
  cityId      String?
  experienceId String?
  startAt     DateTime
  endAt       DateTime?
  message     String?
  status      CompanionRequestStatus   @default(PENDING)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  requester   User                    @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  companion   User                    @relation("companion", fields: [companionId], references: [id], onDelete: Cascade)
  city        City?                   @relation(fields: [cityId], references: [id], onDelete: SetNull)
  experience  Experience?             @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  booking     Booking?

  @@index([requesterId, status])
  @@index([companionId, status])
  @@index([cityId, startAt])
  @@map("companion_requests")
}

model CompanionAvailability {
  id          String   @id @default(cuid())
  companionId String
  weekday     Int
  startMinute Int
  endMinute   Int
  timezone    String   @default("UTC")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companion   User     @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@index([companionId, weekday, isActive])
  @@map("companion_availability")
}

model Booking {
  id           String            @id @default(cuid())
  requestId    String            @unique
  customerId   String
  companionId  String
  cityId       String?
  experienceId String?
  startAt      DateTime
  endAt        DateTime?
  amountMinor  Int               @default(0)
  currency     String            @default("INR")
  status       BookingStatus     @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  request      CompanionRequest  @relation(fields: [requestId], references: [id], onDelete: Restrict)
  customer     User              @relation("bookingCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  companion    User              @relation("bookingCompanion", fields: [companionId], references: [id], onDelete: Restrict)
  city         City?             @relation(fields: [cityId], references: [id], onDelete: SetNull)
  experience   Experience?       @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  payment      Payment?

  @@index([customerId, status])
  @@index([companionId, status])
  @@index([startAt, status])
  @@map("bookings")
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  customerId        String
  provider          String
  providerPaymentId String?
  idempotencyKey    String        @unique
  amountMinor       Int
  currency          String
  status            PaymentStatus @default(CREATED)
  metadata          Json?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customer          User          @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, status])
  @@index([provider, providerPaymentId])
  @@map("payments")
}

model Trip {
  id           String         @id @default(cuid())
  ownerId      String
  title        String
  destination  String
  countryCode  String
  travelType   TripTravelType?
  startAt      DateTime
  endAt        DateTime
  budgetMinor  Int?
  currency     String         @default("INR")
  travelStyle  String?
  interests    String[]       @default([])
  languages    String[]       @default([])
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  owner        User           @relation("tripOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      TripMember[]
  itinerary    ItineraryItem[]
  waitlists    TripWaitlist[]
  checkIns     TripCheckIn[]

  @@index([ownerId, startAt])
  @@index([countryCode, startAt])
  @@index([travelType, countryCode, startAt])
  @@map("trips")
}

model TripMember {
  id       String         @id @default(cuid())
  tripId   String
  userId   String
  role     TripMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now())
  trip     Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_members")
}

model ItineraryItem {
  id           String   @id @default(cuid())
  tripId       String
  title        String
  description  String?
  location     String?
  startAt      DateTime?
  endAt        DateTime?
  notes        String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, startAt])
  @@map("itinerary_items")
}

model TripWaitlist {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId, createdAt])
  @@map("trip_waitlists")
}

model TripCheckIn {
  id           String   @id @default(cuid())
  tripId       String
  userId       String
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId, checkedInAt])
  @@index([userId, checkedInAt])
  @@map("trip_check_ins")
}
