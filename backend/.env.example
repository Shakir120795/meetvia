# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/meetvia

# Redis connection string (for OTP, sessions, locks)
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h

# Server port
PORT=5000

# Node environment
NODE_ENV=development

# File upload limits (in MB)
MAX_IMAGE_SIZE=10
MAX_VIDEO_SIZE=100
